// Shared build settings. Put your own team and bundle ID prefix in Config/Local.xcconfig
// (copy Local.xcconfig.example); that file isn't checked in.

TT_BUNDLE_PREFIX = com.example
DEVELOPMENT_TEAM =
// Off by default: it needs a provisioning profile, so Xcode must be signed in to your Apple account.
TT_ENTITLEMENTS =

// Shared with the widget so it can show the latest numbers (usage only, never credentials).
TT_APP_GROUP = $(TeamIdentifierPrefix)$(TT_BUNDLE_PREFIX).TokenTracker

// Where the app looks for updates (GitHub "owner/repo"). Forks should point this at their own.
TT_UPDATE_REPOSITORY = tristandeschler/ai-usage-tracker

#include? "Local.xcconfig"
